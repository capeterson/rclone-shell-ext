name := 'rclone-shell-ext-plasma'
# The shared binary: the keeper and pin units run it, and both front ends install it.
shared := 'rclone-shell-ext'
# The D-Bus service name (and the plasmoid id); the settings launcher is `desktopid`.
appid := 'com.ca-peterson.rclone-shell-ext'
desktopid := 'com.ca-peterson.rclone-shell-ext.Plasma'
plasmoid := 'plasmoid/com.ca-peterson.rclone-shell-ext'
# Icon name and file glob: owned by the icon rename, so they still carry the old name.
icon := 'rclone-plasma'
# What earlier releases were called (uninstall cleans these up too).
oldname := 'rclone-plasma'
oldappid := 'com.ca-peterson.RclonePlasma'
oldplasmoid := 'com.ca-peterson.rcloneplasma'
prefix := env_var('HOME') / '.local'
plugindir := prefix / 'lib64/qt6/plugins'
# Recipes run in plasma/; the workspace target dir is one level up.
target := '../target'
dolphin_build := target / 'dolphin'

default: build-release

build-release:
    cargo build --release -p {{name}} -p {{name}}-ui -p {{shared}}
    cmake -B {{dolphin_build}} -S dolphin -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX={{prefix}} -DKDE_INSTALL_PLUGINDIR={{plugindir}}
    cmake --build {{dolphin_build}}

test:
    cargo test -p {{name}} -p {{name}}-ui --locked

# Everything CI runs
ci:
    cargo clippy -p {{name}} -p {{name}}-ui --all-targets --locked -- -D warnings
    cargo test -p {{name}} -p {{name}}-ui --locked
    cmake -B {{dolphin_build}} -S dolphin && cmake --build {{dolphin_build}}

# Install under ~/.local. Dolphin finds the plugins through QT_PLUGIN_PATH, which a Plasma env
# script sets from the next login (start Dolphin with it set to test before then).
install-user: build-release
    install -Dm0755 {{target}}/release/{{name}} {{prefix}}/bin/{{name}}
    install -Dm0755 {{target}}/release/{{shared}} {{prefix}}/bin/{{shared}}
    sed 's|@BINDIR@|{{prefix}}/bin|' dbus/{{appid}}.service | install -Dm0644 /dev/stdin {{prefix}}/share/dbus-1/services/{{appid}}.service
    -busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig
    cp -r icons/hicolor/. {{prefix}}/share/icons/hicolor/
    -touch {{prefix}}/share/icons/hicolor
    printf '[Desktop Entry]\nName=rclone UI\nExec={{name}} --settings\nIcon={{icon}}\nType=Application\nNoDisplay=true\n' | install -Dm0644 /dev/stdin {{prefix}}/share/applications/{{desktopid}}.desktop
    kpackagetool6 -t Plasma/Applet -u {{plasmoid}} >/dev/null 2>&1 || kpackagetool6 -t Plasma/Applet -i {{plasmoid}}
    cmake --install {{dolphin_build}}
    printf 'export QT_PLUGIN_PATH="{{plugindir}}${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"\n' | install -Dm0644 /dev/stdin ~/.config/plasma-workspace/env/{{name}}.sh
    # Restart a running daemon so it picks up the new binary (D-Bus starts it again on demand).
    -pkill -x -f '{{prefix}}/bin/{{name}} --daemon'
    -pkill -x -f '{{prefix}}/bin/{{oldname}} --daemon'

# Removes this version's files and the ones earlier versions (rclone-plasma) installed. The
# offline-folder units go first; the shared binary stays while the COSMIC front end needs it.
uninstall-user:
    if [ -x {{prefix}}/bin/{{shared}} ]; then {{prefix}}/bin/{{shared}} --offline-remove; fi
    if [ -x {{prefix}}/bin/{{oldname}} ]; then {{prefix}}/bin/{{oldname}} --offline-remove; fi
    -pkill -x -f '{{prefix}}/bin/{{name}} --daemon'
    -pkill -x -f '{{prefix}}/bin/{{oldname}} --daemon'
    -kpackagetool6 -t Plasma/Applet -r com.ca-peterson.rclone-shell-ext
    -kpackagetool6 -t Plasma/Applet -r {{oldplasmoid}}
    rm -f {{prefix}}/bin/{{name}} {{prefix}}/share/dbus-1/services/{{appid}}.service {{prefix}}/share/applications/{{desktopid}}.desktop ~/.config/plasma-workspace/env/{{name}}.sh
    if [ ! -e {{prefix}}/bin/rclone-shell-ext-cosmic ]; then rm -f {{prefix}}/bin/{{shared}}; fi
    rm -f {{prefix}}/bin/{{oldname}} {{prefix}}/share/dbus-1/services/{{oldappid}}.service {{prefix}}/share/applications/{{oldappid}}.desktop ~/.config/plasma-workspace/env/{{oldname}}.sh
    rm -f {{plugindir}}/kf6/overlayicon/rcloneoverlayplugin.so {{plugindir}}/kf6/kfileitemaction/rclonefileitemaction.so
    find {{prefix}}/share/icons/hicolor -name '{{icon}}*' -delete
